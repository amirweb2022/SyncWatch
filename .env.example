NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional TURN configuration. NEXT_PUBLIC_* values are embedded in browser code
# and visible to every visitor; do not put privileged or long-lived credentials here.
# Static public credentials can be copied and abused. Secure short-lived credentials
# require a trusted issuer, which this no-backend app does not provide.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=your-turn-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-credential
# Multiple TURN endpoints can be comma-separated, for example:
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# Opt-in diagnostic only: require TURN relay candidates (fails if relay is unavailable).
# NEXT_PUBLIC_SYNCWATCH_FORCE_RELAY=1
# Capture resolution/FPS and sender bitrate settings are best-effort requests;
# browser/source/device/network negotiation can produce different quality.
